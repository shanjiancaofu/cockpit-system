[Unit]
Description=cockpit-system Navigator
After=network.target sound.target

[Service]
Type=simple
User=cockpit
Group=cockpit
WorkingDirectory=/cockpit-system
Environment=COCKPIT_AI_ROOT=/cockpit-system/ai
ExecStart=/cockpit-system/current/bin/cockpit-navigator --config /cockpit-system/config/config.yaml --module-dir /cockpit-system/current/lib/cockpit/modules --socket /cockpit-system/run/navigator.sock --mode normal
Restart=on-failure
RestartSec=2
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_CAN
ReadWritePaths=/cockpit-system/data /cockpit-system/logs /cockpit-system/run

[Install]
WantedBy=multi-user.target
