[Unit]
Description=cockpit-system Navigator
After=network.target sound.target

[Service]
Type=simple
User=cockpit
Group=cockpit
WorkingDirectory=/cockpit-system
ExecStartPre=/cockpit-system/current/bin/safe-ota --recover --root /cockpit-system
ExecStart=/cockpit-system/current/bin/cockpit-navigator --config /cockpit-system/config/config.yaml --module-dir /cockpit-system/current/lib/cockpit/modules --socket /cockpit-system/run/navigator.sock --mode normal
Restart=on-failure
RestartSec=2
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_CAN
ReadWritePaths=/cockpit-system

[Install]
WantedBy=multi-user.target
