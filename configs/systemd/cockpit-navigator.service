[Unit]
Description=cockpit-system Module Navigator
After=network.target

[Service]
Type=simple
WorkingDirectory=/cockpit-system
ExecStart=/cockpit-system/current/bin/cockpit-navigator --config /cockpit-system/config/navigator.yaml --module-dir /cockpit-system/current/lib/cockpit/modules
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
