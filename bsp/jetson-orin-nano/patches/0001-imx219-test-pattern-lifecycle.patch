 static int imx219_start_streaming(struct tegracam_device *tc_dev)
 {
-	struct imx219 *priv = (struct imx219 *)tegracam_get_privdata(tc_dev);
-
-	return imx219_write_table(priv, mode_table[IMX219_START_STREAM]);
+	struct imx219 *priv = tegracam_get_privdata(tc_dev);
+	int err = 0;
+
+	mutex_lock(&priv->state_lock);
+	if (priv->streaming)
+		goto done;
+	if (priv->needs_reset || priv->s_data->power->state != SWITCH_ON) {
+		err = -EIO;
+		goto done;
+	}
+	err = cockpit_imx219_apply_pattern(priv);
+	if (!err)
+		err = imx219_write_table(priv, mode_table[IMX219_START_STREAM]);
+	if (err) {
+		/* Best effort standby; preserve the first error and require reset. */
+		imx219_write_table(priv, mode_table[IMX219_STOP_STREAM]);
+		priv->needs_reset = true;
+	} else {
+		priv->streaming = true;
+	}
+done:
+	mutex_unlock(&priv->state_lock);
+	return err;
 }
 
 static int imx219_stop_streaming(struct tegracam_device *tc_dev)
 {
-	struct imx219 *priv = (struct imx219 *)tegracam_get_privdata(tc_dev);
-
-	return imx219_write_table(priv, mode_table[IMX219_STOP_STREAM]);
+	struct imx219 *priv = tegracam_get_privdata(tc_dev);
+	int err = 0;
+
+	mutex_lock(&priv->state_lock);
+	if (priv->streaming || priv->needs_reset) {
+		err = imx219_write_table(priv, mode_table[IMX219_STOP_STREAM]);
+		if (!err)
+			priv->streaming = false;
+		else
+			priv->needs_reset = true;
+	}
+	mutex_unlock(&priv->state_lock);
+	return err;
 }
 
