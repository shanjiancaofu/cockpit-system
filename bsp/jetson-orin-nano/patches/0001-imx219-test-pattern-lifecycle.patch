+static int imx219_set_gain(struct tegracam_device *tc_dev, s64 val)
+{
+	struct imx219 *priv = tegracam_get_privdata(tc_dev);
+	int err;
+
+	mutex_lock(&priv->state_lock);
+	if (priv->s_data->power->state != SWITCH_ON)
+		err = -EPIPE;
+	else if (priv->needs_reset)
+		err = -EIO;
+	else {
+		err = imx219_set_gain_unlocked(tc_dev, val);
+		if (err)
+			priv->needs_reset = true;
+	}
+	mutex_unlock(&priv->state_lock);
+	return err;
+}
